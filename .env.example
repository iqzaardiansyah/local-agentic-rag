# Connection
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.6:latest
LLM_API_KEY=ollama

# Sampling
LLM_TEMPERATURE=0.7
LLM_TOP_P=1.0
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_REPETITION_PENALTY=1.0
LLM_MAX_TOKENS=4096

# Thinking (Qwen-style enable_thinking)
LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=4096

# K2 Horizon extras (auto-detected from model name):
# LLM_REASONING_EFFORT=high
# LLM_TOOL_CALL_FORMAT=xml

# Subagents
SUBAGENT_TEMPERATURE=0.4
# SUBAGENT_MAX_TOKENS=4096
# LLM_MAX_PARALLEL=4
# LLM_TIMEOUT_SECONDS=600
