# Connection
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.6:latest
LLM_API_KEY=ollama

# Sampling / generation
LLM_TEMPERATURE=0.7
LLM_TOP_P=1.0
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_REPETITION_PENALTY=1.0
LLM_MAX_TOKENS=4096

# Thinking (Qwen). Keep off unless LLM_MAX_TOKENS > LLM_THINKING_BUDGET.
LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=4096

# Subagents
SUBAGENT_TEMPERATURE=0.4
# SUBAGENT_MAX_TOKENS=4096
