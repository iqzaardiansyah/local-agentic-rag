# The public ngrok URL from your Kaggle notebook (e.g., https://1234-abcd.ngrok-free.app/v1)
LLM_BASE_URL=http://localhost:11434/v1
# Model name to use (e.g., qwen3.6:27b from the notebook)
LLM_MODEL=qwen3.6:latest

# (Optional) If you were using a real paid API, you'd put the key here. 
# But for our free Ollama server, any string works (OpenAI client requires a string).
LLM_API_KEY=ollama 
